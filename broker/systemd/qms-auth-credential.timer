[Unit]
Description=Renew the QMS broker External Auth session every five minutes
Documentation=file:///opt/qms-qdn-test-broker/docs/migration-studio/PHASE-5.2-CREDENTIAL-LIFECYCLE.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=qms-auth-credential.service

[Install]
WantedBy=timers.target
