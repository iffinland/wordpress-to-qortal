[Unit]
Description=Qortal External Auth credential renewal for the QMS QDN test broker
Documentation=file:///opt/qms-qdn-test-broker/docs/migration-studio/PHASE-5.2-CREDENTIAL-LIFECYCLE.md
After=network-online.target qortal-external-auth.service qms-qdn-test-broker.service
Wants=network-online.target

[Service]
Type=oneshot
User=qms-auth-supervisor
Group=qms-auth-supervisor
SupplementaryGroups=qms-broker
Environment=QMS_AUTH_SUPERVISOR_CONFIG=/etc/qms-qdn-auth-credential/supervisor.json
ExecStart=/usr/bin/node /opt/qms-qdn-test-broker/broker/src/credentials/supervisor.js --once
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/qms-auth-credential
ReadOnlyPaths=/etc/qms-qdn-auth-credential
InaccessiblePaths=/var/lib/qortal-external-auth /var/lib/qms-qdn-test-broker /etc/qms-qdn-test-broker
