{
  "name": "wp-to-qortal",
  "version": "0.1.0",
  "description": "A small WordPress to Qortal-native JSON importer MVP.",
  "type": "module",
  "private": true,
  "scripts": {
    "dump": "node src/dump.js",
    "convert": "node src/convertRaw.js",
    "plan-media": "node src/planMedia.js",
    "download-media": "node src/downloadMedia.js",
    "validate": "node src/validate.js",
    "validate:media": "node src/validate.js --require-media",
    "prepare-publish": "node src/preparePublish.js",
    "viewer:dev": "npm --prefix viewer run dev",
    "viewer:build": "npm --prefix viewer run build",
    "viewer:preview": "npm --prefix viewer run preview",
    "prepare": "npm run dump && npm run convert && npm run plan-media && npm run download-media && npm run validate",
    "dump:sample": "node src/dump.js --sample && node src/convertRaw.js",
    "inspect": "node src/inspect.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7"
  }
}
