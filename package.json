{
  "name": "wp-to-qortal",
  "version": "0.1.5",
  "description": "WordPress to Qortal migration importer and QDN publisher.",
  "type": "module",
  "private": true,
  "workspaces": [
    "viewer"
  ],
  "scripts": {
    "start": "npm run migration:dev",
    "test": "node --test",
    "dump": "node src/dump.js",
    "convert": "node src/convertRaw.js",
    "plan-media": "node src/planMedia.js",
    "download-media": "node src/downloadMedia.js",
    "validate": "node src/validate.js",
    "validate:media": "node src/validate.js --require-media",
    "prepare-publish": "node src/preparePublish.js",
    "merge-manifests": "node src/mergeQdnManifests.js",
    "publish": "node src/publish.js",
    "migration:dev": "npm --prefix viewer run dev",
    "migration:build": "npm --prefix viewer run build",
    "migration:preview": "npm --prefix viewer run preview",
    "viewer:dev": "npm --prefix viewer run dev",
    "viewer:build": "npm --prefix viewer run build",
    "viewer:preview": "npm --prefix viewer run preview",
    "cms:dev": "npm --prefix qortal-cms run dev",
    "cms:build": "npm --prefix qortal-cms run build",
    "cms:preview": "npm --prefix qortal-cms run preview",
    "corbettreport:dev": "npm --prefix corbettreport run dev",
    "corbettreport:build": "npm --prefix corbettreport run build",
    "corbettreport:preview": "npm --prefix corbettreport run preview",
    "corbettreport:batch:next": "node scripts/runCorbettBatch.js next",
    "corbettreport:batch:retry": "node scripts/runCorbettBatch.js retry",
    "corbettreport:batch:init": "node scripts/runCorbettBatch.js init",
    "corbettreport:batch:complete": "node scripts/runCorbettBatch.js complete",
    "corbettreport:batch:catalog": "node scripts/runCorbettBatch.js catalog",
    "corbettreport:batch:cleanup": "node scripts/runCorbettBatch.js cleanup",
    "corbettreport:batch:status": "node scripts/runCorbettBatch.js status",
    "prepare-import": "npm run dump && npm run convert && npm run plan-media && npm run download-media && npm run validate",
    "check": "npm run validate:media && npm run migration:build",
    "check:cms": "npm run cms:build",
    "dump:sample": "OUTPUT_DIR=./workspaces/sample-import node src/dump.js --sample && OUTPUT_DIR=./workspaces/sample-import node src/convertRaw.js",
    "inspect": "node src/inspect.js",
    "package:migration": "node scripts/createMigrationPackage.js",
    "package:zip": "node scripts/createMigrationZip.js",
    "package:migration-qapp": "npm run package:migration-qapp:generic",
    "package:migration-qapp:generic": "node scripts/createMigrationQappZip.js --profile=generic",
    "package:migration-qapp:corbettreport": "node scripts/createMigrationQappZip.js --profile=corbettreport",
    "package:cms-qapp": "npm run package:cms-qapp:generic",
    "package:cms-qapp:generic": "node scripts/createCmsQappZip.js --profile=generic",
    "package:cms-qapp:corbettreport": "node scripts/createCmsQappZip.js --profile=corbettreport",
    "package:tester-bundle": "node scripts/createTesterBundle.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7"
  }
}
