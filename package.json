{
  "name": "wp-to-qortal",
  "version": "0.1.0",
  "description": "WordPress to Qortal migration importer and QDN publisher.",
  "type": "module",
  "private": true,
  "workspaces": [
    "viewer"
  ],
  "scripts": {
    "start": "npm run migration:dev",
    "dump": "node src/dump.js",
    "convert": "node src/convertRaw.js",
    "plan-media": "node src/planMedia.js",
    "download-media": "node src/downloadMedia.js",
    "validate": "node src/validate.js",
    "validate:media": "node src/validate.js --require-media",
    "prepare-publish": "node src/preparePublish.js",
    "publish": "node src/publish.js",
    "migration:dev": "npm --prefix viewer run dev",
    "migration:build": "npm --prefix viewer run build",
    "migration:preview": "npm --prefix viewer run preview",
    "viewer:dev": "npm --prefix viewer run dev",
    "viewer:build": "npm --prefix viewer run build",
    "viewer:preview": "npm --prefix viewer run preview",
    "cms:dev": "npm --prefix qortal-cms run dev",
    "cms:build": "npm --prefix qortal-cms run build",
    "cms:preview": "npm --prefix qortal-cms run preview",
    "prepare-import": "npm run dump && npm run convert && npm run plan-media && npm run download-media && npm run validate",
    "check": "npm run validate:media && npm run migration:build",
    "check:cms": "npm run cms:build",
    "dump:sample": "node src/dump.js --sample && node src/convertRaw.js",
    "inspect": "node src/inspect.js",
    "package:migration": "node scripts/createMigrationPackage.js",
    "package:zip": "node scripts/createMigrationZip.js",
    "package:migration-qapp": "node scripts/createMigrationQappZip.js",
    "package:cms-qapp": "node scripts/createCmsQappZip.js",
    "package:tester-bundle": "node scripts/createTesterBundle.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7"
  }
}
