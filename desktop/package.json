{
  "name": "qortal-migration-studio",
  "productName": "Qortal Migration Studio",
  "version": "0.8.0-alpha.12",
  "description": "Linux desktop application for safely preparing WordPress-to-Qortal migrations.",
  "private": true,
  "main": "dist-electron/main.cjs",
  "author": "Qortal Migration Studio contributors",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "dist:dir": "npm run build && npm run prepare:engine && electron-builder --linux dir",
    "dist:deb": "node ../scripts/release/build-deb.mjs",
    "verify:package": "node ../scripts/release/validate-artifact.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/iffinland/wordpress-to-qortal",
  "repository": {
    "type": "git",
    "url": "git@github.com:iffinland/wordpress-to-qortal.git"
  }
}
