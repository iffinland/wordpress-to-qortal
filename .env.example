WORDPRESS_BASE_URL=https://example.com
MIGRATION_PROFILE=generic
OUTPUT_DIR=./wp-qortal-import
LIMIT_POSTS=5
LIMIT_PAGES=5
LIMIT_CATEGORIES=100
LIMIT_TAGS=100
LIMIT_MEDIA=20
MEDIA_SCOPE=library
DOWNLOAD_MEDIA=false
DOWNLOAD_EXTERNAL_MEDIA=false
DOWNLOAD_MEDIA_TYPES=image,audio,video,document,file
WORDPRESS_AUTH_MODE=application_password
WORDPRESS_LOGIN_URL=/login/
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
WORDPRESS_PASSWORD=
QORTAL_NAME=
QORTAL_SITE_NAME=
QORTAL_CONTENT_NAME=
QORTAL_MEDIA_NAME=
QORTAL_PUBLISHER_NAMES=
QORTAL_COAUTHOR_NAMES=
PUBLIC_AUTHOR_NAME=
QORTAL_NODE_URL=http://localhost:12391
QORTAL_API_KEY=
QORTAL_API_KEY_FILE=~/qortal/apikey.txt
