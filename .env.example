# WordPress login for corbettreport.com.
# Use a normal WordPress account login. This toolkit does not need wp-admin.
WORDPRESS_BASE_URL=https://corbettreport.com
WORDPRESS_AUTH_MODE=session
WORDPRESS_LOGIN_URL=/login/
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=
WORDPRESS_APP_PASSWORD=

# The Corbett Report migration profile is the only supported profile.
MIGRATION_PROFILE=corbettreport

# Imported files stay in this folder on your computer.
OUTPUT_DIR=./wp-qortal-import

# These limits are used by the basic commands. The batch workflow sets its own
# limits for each batch. Keep the large values for a full archive import.
LIMIT_POSTS=100000
LIMIT_RECENT_POSTS=100
LIMIT_PAGES=100000
LIMIT_CATEGORIES=10000
LIMIT_TAGS=10000
LIMIT_MEDIA=100000
MEDIA_SCOPE=selected_posts
DOWNLOAD_MEDIA=true
DOWNLOAD_EXTERNAL_MEDIA=false
DOWNLOAD_MEDIA_TYPES=image,audio,video,document,file
MEDIA_DOWNLOAD_CONCURRENCY=2
MEDIA_DOWNLOAD_ATTEMPTS=3
MEDIA_DOWNLOAD_RETRY_DELAY_MS=3000

# Qortal names:
# - Content is published under the registered name "Corbett".
# - The website/CMS app is published as WEBSITE/CorbettReport.
QORTAL_NAME=Corbett
QORTAL_SITE_NAME=Corbett
QORTAL_CONTENT_NAME=Corbett
QORTAL_MEDIA_NAME=
QORTAL_PUBLISHER_NAMES=Corbett
QORTAL_COAUTHOR_NAMES=AgoristMarket,iffi
PUBLIC_AUTHOR_NAME=Corbett

# Local Qortal Core API. Qortal Hub normally uses port 12391.
QORTAL_NODE_URL=http://localhost:12391
QORTAL_API_KEY=
QORTAL_API_KEY_FILE=~/qortal/apikey.txt

# Optional first-batch safety limits. The defaults are used when these are unset.
# CORBETT_BATCH_SIZE=10
# CORBETT_RECENT_LIMIT=10
